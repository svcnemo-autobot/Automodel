# syntax=docker/dockerfile:1
# Controlled bisection artifact: 26.06 nemo-automodel image with ONLY TransformerEngine
# downgraded to release_v2.11 (the 26.04 TE), holding torch/CUDA/DeepEP/NVSHMEM/AutoModel at 26.06.
ARG BASE=nvcr.io/nvidia/nemo-automodel:26.06
FROM ${BASE}
ARG TE_COMMIT=release_v2.11
ENV PIP_NO_CACHE_DIR=1
# The 26.06 image uses a uv-managed venv at /opt/venv (no bundled pip). uv is on PATH
# (installed to /root/.local/bin by the base build). Use `uv pip` against the venv python.
ENV PATH="/root/.local/bin:/opt/venv/bin:${PATH}"
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
RUN set -eux; \
    PY=/opt/venv/bin/python; \
    uv pip install --python "$PY" --reinstall nvidia-mathdx==25.1.1; \
    uv pip uninstall --python "$PY" transformer_engine transformer_engine_cu13 || true; \
    git clone https://github.com/NVIDIA/TransformerEngine.git /tmp/TE; \
    cd /tmp/TE; \
    git fetch origin ${TE_COMMIT}; \
    git checkout FETCH_HEAD; \
    git submodule update --init --recursive; \
    env NVTE_CUDA_ARCHS="90" NVTE_BUILD_THREADS_PER_JOB=8 NVTE_FRAMEWORK=pytorch \
        uv pip install --python "$PY" --no-build-isolation -v .; \
    cd /; rm -rf /tmp/TE
RUN /opt/venv/bin/python -c "import transformer_engine as te; print('TE', te.__version__)"
